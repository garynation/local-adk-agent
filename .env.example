# Container Image from GitHub Container Registry
AGENT_IMAGE=ghcr.io/garynation/local-adk-agent:latest

# Host bind address & port (use 127.0.0.1 for local/Tailscale proxy, or 0.0.0.0 for LAN access)
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080

# Persistent host directory for credentials, OAuth tokens, SQLite DB, and Chrome profile.
# Stored in ~/.config/local-adk-agent/data (outside the repo/app folder) so app updates,
# `docker compose pull && docker compose up -d`, `git clean`, or re-cloning never overwrite your credentials.
HOST_DATA_DIR=~/.config/local-adk-agent/data

# Host Linux UID/GID so persistent data files are owned by your Linux user
PUID=1000
PGID=1000
TZ=Europe/London

# NOTE: Do NOT put GEMINI_API_KEY, OAuth Client Secrets, or Service Account keys in this file!
# Configure all API keys and OAuth credentials via the Web UI Settings Console (saved to ~/.config/local-adk-agent/data/).
