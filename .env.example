# Container Image from GitHub Container Registry
AGENT_IMAGE=ghcr.io/garynation/local-adk-agent:latest

# Host bind address & port (0.0.0.0 allows access from your laptop/phone on LAN or Tailscale)
BIND_ADDRESS=0.0.0.0
HOST_PORT=8080

# Persistent host directory for credentials, OAuth tokens, SQLite DB, and Chrome profile.
# Defaults in docker-compose.yml to ${HOME}/.config/local-adk-agent/data (outside the repo/app folder)
# so app updates, `docker compose pull && docker compose up -d`, or re-cloning never overwrite your credentials.
# Uncomment below only if you want to override the default path with an absolute path:
# HOST_DATA_DIR=/home/your-linux-user/.config/local-adk-agent/data

# Host Linux UID/GID so persistent data files are owned by your Linux user
PUID=1000
PGID=1000
TZ=Europe/London

# NOTE: Do NOT put GEMINI_API_KEY, OAuth Client Secrets, or Service Account keys in this file!
# Configure all API keys and OAuth credentials via the Web UI Settings Console (saved to ~/.config/local-adk-agent/data/).
